# === Required ===
GATEWAY_MASTER_KEY=           # Master key for admin endpoints (/key/*, /user/*)
GATEWAY_SALT_KEY=             # Fernet encryption key for provider credentials (URL-safe base64, 32 bytes)

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# === Provider Credentials ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=   # Path to GCP service account JSON (Vertex AI)
AWS_ACCESS_KEY_ID=                 # Bedrock
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# === Observability ===
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
SLACK_WEBHOOK_URL=

# === Gateway ===
CONFIG_PATH=config.yaml
PORT=4000
LOG_LEVEL=INFO
